# Copy this file to ".env" next to docker-compose.prod.yml and fill in real values.
# "docker compose" reads .env automatically — never commit the real .env file.

# Public address people use to reach the site (no trailing slash).
# Use "http://SEU_IP_OU_DOMINIO" for now; switch to "https://seudominio.com" once SSL is set up.
PUBLIC_ORIGIN=http://191.96.156.53

# MySQL
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-do-mysql
MYSQL_PASSWORD=troque-esta-senha-do-usuario-aki

# A long random string used to sign admin login tokens.
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa
