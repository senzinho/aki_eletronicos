// Prisma schema — espelha manualmente database/schema.sql (fonte canônica).
// Não usar `prisma migrate` aqui: schema.sql é aplicado diretamente no MySQL
// (via docker-entrypoint-initdb.d) para não criar duas histórias de migração.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(180)
  username     String    @unique @db.VarChar(60)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("admins")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  icon      String?   @db.VarChar(60)
  ordering  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  logo      String?   @db.VarChar(255)
  link      String?   @db.VarChar(255)
  ordering  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("brands")
}

enum ProductStatus {
  draft
  published
}

model Product {
  id                       Int             @id @default(autoincrement())
  name                     String          @db.VarChar(160)
  slug                     String          @unique @db.VarChar(180)
  subtitle                 String?         @db.VarChar(200)
  description              String?         @db.Text
  brandId                  Int?            @map("brand_id")
  categoryId               Int?            @map("category_id")
  priceFrom                Decimal?        @map("price_from") @db.Decimal(10, 2)
  priceTo                  Decimal         @map("price_to") @db.Decimal(10, 2)
  pricePix                 Decimal?        @map("price_pix") @db.Decimal(10, 2)
  installmentMax           Int?            @map("installment_max")
  installmentInterestFree  Boolean         @default(true) @map("installment_interest_free")
  installmentNote          String?         @map("installment_note") @db.VarChar(160)
  badge                    String?         @db.VarChar(40)
  mainImage                String?         @map("main_image") @db.VarChar(255)
  ratingAvg                Decimal?        @map("rating_avg") @db.Decimal(2, 1)
  ratingCount              Int             @default(0) @map("rating_count")
  isDemo                   Boolean         @default(false) @map("is_demo")
  isFeatured               Boolean         @default(false) @map("is_featured")
  status                   ProductStatus   @default(published)
  ordering                 Int             @default(0)
  seoTitle                 String?         @map("seo_title") @db.VarChar(180)
  seoDescription           String?         @map("seo_description") @db.VarChar(255)
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @default(now()) @updatedAt @map("updated_at")

  brand                    Brand?          @relation(fields: [brandId], references: [id])
  category                 Category?       @relation(fields: [categoryId], references: [id])
  images                   ProductImage[]
  variants                 ProductVariant[]
  analyticsEvents          AnalyticsEvent[]

  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  image     String  @db.VarChar(255)
  ordering  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  color          String?  @db.VarChar(60)
  storage        String?  @db.VarChar(60)
  priceOverride  Decimal? @map("price_override") @db.Decimal(10, 2)
  isAvailable    Boolean  @default(true) @map("is_available")
  ordering       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Banner {
  id             Int              @id @default(autoincrement())
  internalName   String           @map("internal_name") @db.VarChar(120)
  title          String?          @db.VarChar(160)
  subtitle       String?          @db.VarChar(200)
  imageDesktop   String?          @map("image_desktop") @db.VarChar(255)
  imageMobile    String?          @map("image_mobile") @db.VarChar(255)
  ctaText        String?          @map("cta_text") @db.VarChar(80)
  url            String?          @db.VarChar(255)
  ordering       Int              @default(0)
  isActive       Boolean          @default(true) @map("is_active")
  startDate      DateTime?        @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at")
  analyticsEvents AnalyticsEvent[]

  @@map("banners")
}

model PromotionalBar {
  id        Int       @id @default(autoincrement())
  text      String    @db.VarChar(200)
  icon      String?   @db.VarChar(20)
  ordering  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("promotional_bars")
}

model SocialLink {
  id       Int     @id @default(autoincrement())
  platform String  @db.VarChar(40)
  url      String  @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  @@map("social_links")
}

model SiteSetting {
  settingKey   String  @id @map("setting_key") @db.VarChar(60)
  settingValue String? @map("setting_value") @db.Text

  @@map("site_settings")
}

enum ServiceRequestType {
  reparo
  contato
}

enum ServiceRequestStatus {
  novo
  em_andamento
  concluido
}

model ServiceRequest {
  id          Int                   @id @default(autoincrement())
  type        ServiceRequestType    @default(contato)
  name        String                @db.VarChar(120)
  phone       String                @db.VarChar(30)
  email       String?               @db.VarChar(180)
  deviceModel String?               @map("device_model") @db.VarChar(120)
  problemType String?               @map("problem_type") @db.VarChar(120)
  message     String?               @db.Text
  status      ServiceRequestStatus  @default(novo)
  createdAt   DateTime              @default(now()) @map("created_at")

  @@map("service_requests")
}

enum AnalyticsEventType {
  page_view
  product_view
  whatsapp_click
  banner_click
}

model AnalyticsEvent {
  id        BigInt             @id @default(autoincrement())
  eventType AnalyticsEventType @map("event_type")
  productId Int?               @map("product_id")
  bannerId  Int?               @map("banner_id")
  page      String?            @db.VarChar(255)
  createdAt DateTime           @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id])
  banner  Banner?  @relation(fields: [bannerId], references: [id])

  @@index([eventType, createdAt])
  @@map("analytics_events")
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  authorName String   @map("author_name") @db.VarChar(120)
  rating     Int      @default(5) @db.UnsignedTinyInt
  comment    String   @db.Text
  context    String?  @db.VarChar(160)
  isActive   Boolean  @default(true) @map("is_active")
  ordering   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}
